# TLS is required (SPEC §4.1, §9): the shop-floor app and camera QR scanning only
# work in a secure context. TLS_MODE in .env picks how the certificate is
# obtained; config/caddy/tls-<mode>.conf is copied into place at start-up and an
# unknown value stops the proxy rather than falling back to something weaker.
#
#   internal  Caddy's own CA. Works with no domain; install its root on each device.
#   acme-dns  A real Let's Encrypt certificate via a DNS challenge. Needs a domain
#             you control, but the instance never has to be reachable from outside.
#   custom    Your own certificate and key in config/caddy/certs/.
#
# A network that already has a reverse proxy does not need this one at all:
# see docker-compose.external-proxy.yml.

# Caddy listens on the same ports the host publishes (HTTP_PORT and HTTPS_PORT
# in .env; 8726 and 8727 unless changed), not on 80 and 443 behind a remap.
# What it tells browsers then names the right port: the HTTP/3 advertisement
# (Alt-Svc) carries Caddy's own port, and pointing it at 443 on a host where
# something else owns 443 sends browsers to that service and its certificate.
{
	http_port {$HTTP_PORT:8726}
	https_port {$HTTPS_PORT:8727}
	# A client gets 10 seconds to send its request headers, so connections that
	# trickle them in can't pile up.
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

{$SITE_ADDRESS:trammel.home.arpa} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Uploads up to the app's own limit, plus room for form overhead.
	request_body {
		max_size 512MB
	}

	# Caddy sets X-Forwarded-For to the connecting address, discarding whatever
	# the client sent, and the app believes it (TRUSTED_PROXIES in compose).
	reverse_proxy app:8080

	import /etc/caddy/tls.conf

	log {
		output stdout
		format console
	}
}

http:// {
	redir https://{host}{$HTTPS_PORT_SUFFIX}{uri} permanent
}
