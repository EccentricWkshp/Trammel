# Trammel environment. Copy to .env and edit.
#
# Only infrastructure lives here: things the process needs before it can read
# its own database. Everything about the business (name, currency, rates,
# prefixes) is entered on the setup page and in Settings, and stored in the
# database.

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Encrypts integration and SMTP credentials at rest (SPEC §9). Blank derives it
# from SECRET_KEY. Rotating it invalidates every stored credential.
CREDENTIAL_KEY=

# true only on a development machine.
DEBUG=false

# The address people use to reach this instance, including any non-default
# port. Used for links in emails and QR codes on travelers and labels.
BASE_URL=https://trammel.home.arpa

# Comma-separated host names this instance answers to.
ALLOWED_HOSTS=trammel.home.arpa

# PostgreSQL. In the Docker stack the database is created with this password and
# the app is pointed at it automatically. Use a long random value.
POSTGRES_PASSWORD=
# Outside Docker (development: docker-compose.dev.yml), set the URL directly:
# DATABASE_URL=postgresql://trammel:trammel-dev@127.0.0.1:5433/trammel

# --- Proxy and TLS (docker-compose.yml) ---------------------------------------
# The host name devices use. Must match BASE_URL's host.
SITE_ADDRESS=trammel.home.arpa
# internal (Caddy's own CA; install its root on each device), acme-dns (real
# certificate via a DNS challenge; needs a domain), or custom (config/caddy/certs).
TLS_MODE=internal
# Ports the host publishes. Change if something else already uses 80/443, and
# put the HTTPS port in BASE_URL too (e.g. https://trammel.home.arpa:8443).
HTTP_PORT=80
HTTPS_PORT=443
# For TLS_MODE=acme-dns:
ACME_EMAIL=
ACME_DNS_PROVIDER=
ACME_DNS_TOKEN=

# Image tag to run; pin a version such as 0.1.0 for predictable upgrades.
TRAMMEL_TAG=latest

# Turns off every outbound connection at once: update check, SMTP, importers
# (SPEC §3.1). Also switchable in Settings; this forces it on.
OFFLINE_MODE=false

LOG_LEVEL=INFO
